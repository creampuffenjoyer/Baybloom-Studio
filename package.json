{
  "name": "baybloom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/commerce.test.mjs tests/security.test.mjs tests/reliability.test.mjs tests/harbor-translations.test.mjs tests/coral-cove.test.mjs tests/pine-ridge.test.mjs tests/isla-translations.test.mjs",
    "test:integration": "node --conditions=react-server --import tsx --test tests/commerce.integration.mjs",
    "db:migrate": "node scripts/migrate.mjs dev",
    "db:deploy": "node scripts/migrate.mjs deploy",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "templates:pack": "node scripts/pack-templates.mjs",
    "templates:capture": "node scripts/capture-catalog.mjs && node scripts/compose-covers.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "next": "16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "stripe": "^23.0.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "fflate": "^0.8.2",
    "playwright-core": "^1.56.1",
    "prisma": "^6.19.3",
    "shadcn": "^4.21.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
