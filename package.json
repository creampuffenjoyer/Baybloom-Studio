{
  "name": "baybloom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/membership.test.mjs tests/commerce.test.mjs tests/security.test.mjs tests/reliability.test.mjs tests/harbor-translations.test.mjs tests/coral-cove.test.mjs tests/pine-ridge.test.mjs tests/isla-translations.test.mjs tests/harbor-personalization.test.mjs tests/personalization-image.test.mjs tests/personalization-origin.test.mjs tests/personalization-test-runner.test.mjs tests/personalization-package.test.mjs tests/coral-photo-placements.test.mjs tests/harbor-photo-placements.test.mjs tests/purchase-delivery.test.mjs tests/photo-rollout.test.mjs tests/web-security.test.mjs tests/breached-passwords.test.mjs tests/mfa.test.mjs tests/workspace-run.test.mjs",
    "test:security:e2e": "node --test tests/web-security.browser.mjs",
    "test:storage": "node scripts/test-photo-quota.mjs",
    "test:purchase:e2e": "node --conditions=react-server --import tsx --test tests/purchase-delivery.browser.mjs",
    "test:purchase:phase3": "node scripts/test-phase3-purchase.mjs",
    "test:photos:coral": "node --conditions=react-server --import tsx --test tests/coral-photo-editor.browser.mjs",
    "test:photos:coral:export": "node scripts/verify-coral-photo-export.mjs",
    "test:photos:harbor": "node --conditions=react-server --import tsx --test tests/harbor-photo-editor.browser.mjs",
    "test:photos:harbor:export": "node scripts/verify-harbor-photo-export.mjs",
    "test:database": "node scripts/test-personalization-db.mjs",
    "test:integration": "node --conditions=react-server --import tsx --test tests/commerce.integration.mjs",
    "test:personalization:e2e": "node --test tests/personalization-real.browser.mjs",
    "db:migrate": "node scripts/migrate.mjs dev",
    "db:deploy": "node scripts/migrate.mjs deploy",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "templates:pack": "node scripts/pack-templates.mjs",
    "templates:verify:phase3": "node scripts/verify-template-exports.mjs",
    "test:exports:phase3": "node --test tests/template-export-phase3.browser.mjs",
    "templates:capture": "node scripts/capture-catalog.mjs && node scripts/compose-covers.mjs",
    "test:photos:pilots": "node scripts/test-photo-pilots.mjs",
    "test:photos:remaining": "node --conditions=react-server --import tsx --test --test-concurrency=1 tests/photo-rollout.browser.mjs",
    "test:photos:remaining:export": "node --conditions=react-server --import tsx scripts/verify-remaining-photo-exports.mjs",
    "test:mfa": "node scripts/test-mfa.mjs",
    "test:retention": "node scripts/test-retention.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@gsap/react": "^2.1.2",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "fflate": "^0.8.3",
    "gsap": "^3.15.1",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "stripe": "^23.0.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright-core": "^1.56.1",
    "prisma": "^6.19.3",
    "shadcn": "^4.21.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
