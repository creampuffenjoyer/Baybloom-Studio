# Neon Postgres: pooled connection for the app, direct (no "-pooler") for migrations
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Auth.js — generate with: npx auth secret  (or any 32+ random bytes, base64)
AUTH_SECRET=""
# Optional Google sign-in (button is hidden until both are set)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

NEXT_PUBLIC_SITE_NAME="Baybloom Studio"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: `npm run db:seed` creates this admin account when both are set
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Email (verification, password reset). Without a key, emails print to the console.
RESEND_API_KEY=""
EMAIL_FROM="Baybloom Studio <hello@your-domain.com>"

# Phase 4+ (not used yet)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

