# Neon Postgres: pooled connection for the app, direct (no "-pooler") for migrations
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Auth.js — generate with: npx auth secret  (or any 32+ random bytes, base64)
AUTH_SECRET=""
# Set to the public HTTPS origin on production, e.g. https://your-service.up.railway.app.
# Railway defaults to https:// plus its RAILWAY_PUBLIC_DOMAIN when this is unset.
# AUTH_URL="https://your-service.up.railway.app"
# Admin MFA: independent 32 random bytes encoded as standard base64. Keep this
# key with database backups; rotating it requires re-encrypting stored MFA seeds.
MFA_ENCRYPTION_KEY=""
# Optional Google sign-in (button is hidden until both are set)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

NEXT_PUBLIC_SITE_NAME="Baybloom Studio"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: `npm run db:seed` creates this admin account when both are set
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Email (verification, password reset). Required outside NODE_ENV=development.
# Development without a key prints emails to the console; production never logs recovery links.
RESEND_API_KEY=""
EMAIL_FROM="Baybloom Studio <hello@your-domain.com>"

# Required for the scheduled POST /api/jobs/maintenance worker (32+ random characters).
MAINTENANCE_SECRET=""

# Stripe, test mode first (sk_test_… / pk_test_…). Webhook secret comes from `stripe listen`.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Private file storage (Cloudflare R2 or S3). Leave empty in dev to use ./storage
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

uipro init --ai codex

# PayMongo hosted GCash checkout (start with sk_test_). Set ENABLED only once GCash
# is active on the merchant account and the signed webhook has been verified.
PAYMONGO_GCASH_ENABLED="false"
PAYMONGO_SECRET_KEY=""
PAYMONGO_WEBHOOK_SECRET=""
