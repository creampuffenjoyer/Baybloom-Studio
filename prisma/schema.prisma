generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CLIENT
  ADMIN
}

enum DesignStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TierLevel {
  STARTER
  STANDARD
  PREMIUM
}

enum ImageKind {
  PHOTO // photography used by the template
  MOCKUP // shown inside a device frame
  SCREENSHOT // captured from the live demo
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum TokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

// ─── Users & auth ────────────────────────────────────────────────────────────

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String?
  image              String?
  passwordHash       String?
  role               Role      @default(CLIENT)
  emailVerified      DateTime?
  disabled           Boolean   @default(false)
  /// Sessions issued before this moment are rejected (set on password change/reset).
  sessionsValidAfter DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Billing details, used to pre-fill checkout and on invoices
  phone        String?
  company      String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  region       String?
  postalCode   String?
  country      String  @default("PH")

  accounts  Account[]
  favorites Favorite[]
  cartItems CartItem[]
  orders    Order[]
  personalizationDrafts PersonalizationDraft[]
  mfa MfaCredential?
}

model MfaCredential {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret String?
  enabledAt DateTime?
  pendingSecret String?
  pendingExpiresAt DateTime?
  recoveryHashes String[] @default([])
  lastStep Int @default(-1)
  version Int @default(0)
}

/// One saved pilot draft per account and template.
model PersonalizationDraft {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  template  String
  content   Json
  /// One normalized pilot hero image, private to the owning account.
  heroImage Bytes?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  images    PersonalizationDraftImage[]

  @@unique([userId, template])
}

/// Private, normalized images attached to named slots in a draft.
model PersonalizationDraftImage {
  id        String   @id @default(cuid())
  draft     PersonalizationDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  draftId   String
  slot      String
  image     Bytes
  updatedAt DateTime @updatedAt

  @@unique([draftId, slot])
}

/// OAuth identities (e.g. Google) linked to a user.
model Account {
  id                String @id @default(cuid())
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  provider          String
  providerAccountId String

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Single-use tokens for email verification and password reset. Only a hash is stored.
model VerificationToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  type      TokenType
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([email, type])
}

// ─── Catalog ─────────────────────────────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  position    Int      @default(0)
  designs     Design[]
}

model Style {
  id       String   @id @default(cuid())
  name     String   @unique
  slug     String   @unique
  position Int      @default(0)
  designs  Design[]
}

model Design {
  id           String       @id @default(cuid())
  slug         String       @unique
  title        String
  summary      String
  description  String
  status       DesignStatus @default(DRAFT)
  featured     Boolean      @default(false)
  category     Category     @relation(fields: [categoryId], references: [id])
  categoryId   String
  style        Style?       @relation(fields: [styleId], references: [id])
  styleId      String?
  heroImage    String
  heroAlt      String       @default("")
  demoUrl      String?
  /// Included files / deliverables list shown on the detail page.
  deliverables String[]
  viewCount    Int          @default(0)
  publishedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  images     DesignImage[]
  tiers      Tier[]
  features   DesignFeature[]
  addons     Addon[]
  favorites  Favorite[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  files      DeliverableFile[]

  @@index([status])
  @@index([categoryId])
}

model DesignImage {
  id         String    @id @default(cuid())
  design     Design    @relation(fields: [designId], references: [id], onDelete: Cascade)
  designId   String
  url        String
  thumbUrl   String?
  alt        String    @default("")
  kind       ImageKind @default(PHOTO)
  width      Int?
  height     Int?
  position   Int       @default(0)
  // Attribution for freely licensed images (required by CC BY / CC BY-SA)
  creditName String?
  creditUrl  String?
  license    String?
  licenseUrl String?

  @@index([designId, position])
}

model Tier {
  id         String    @id @default(cuid())
  design     Design    @relation(fields: [designId], references: [id], onDelete: Cascade)
  designId   String
  level      TierLevel
  name       String
  priceCents Int
  currency   String    @default("PHP")
  inclusions String[]
  revisions  Int       @default(1)

  cartItems  CartItem[]
  orderItems OrderItem[]
  files      DeliverableFile[]

  @@unique([designId, level])
}

/// An add-on with no designId applies to every design (e.g. hosting setup).
model Addon {
  id          String  @id @default(cuid())
  design      Design? @relation(fields: [designId], references: [id], onDelete: Cascade)
  designId    String?
  name        String
  description String?
  priceCents  Int
  currency    String  @default("PHP")
  active      Boolean @default(true)

  @@index([designId])
}

model Feature {
  id      String          @id @default(cuid())
  name    String          @unique
  slug    String          @unique
  group   String // e.g. "Booking", "Content", "Marketing"
  designs DesignFeature[]
}

model DesignFeature {
  design    Design  @relation(fields: [designId], references: [id], onDelete: Cascade)
  designId  String
  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  featureId String

  @@id([designId, featureId])
  @@index([featureId])
}

/// Purchasable files kept in the private bucket. A file is included from its tier upward.
model DeliverableFile {
  id         String   @id @default(cuid())
  design     Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  designId   String
  minTier    Tier?    @relation(fields: [minTierId], references: [id], onDelete: SetNull)
  minTierId  String?
  name       String
  storageKey String
  sizeBytes  Int?
  createdAt  DateTime @default(now())

  @@index([designId])
}

// ─── Client features ─────────────────────────────────────────────────────────

model Favorite {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  design    Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  designId  String
  createdAt DateTime @default(now())

  @@id([userId, designId])
  @@index([designId])
}

model CartItem {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  design    Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  designId  String
  tier      Tier     @relation(fields: [tierId], references: [id], onDelete: Cascade)
  tierId    String
  addonIds  String[]
  createdAt DateTime @default(now())

  @@unique([userId, designId])
}

// ─── Commerce ────────────────────────────────────────────────────────────────

model Order {
  id                 String      @id @default(cuid())
  user               User        @relation(fields: [userId], references: [id])
  userId             String
  status             OrderStatus @default(PENDING)
  subtotalCents      Int
  discountCents      Int         @default(0)
  totalCents         Int
  currency           String
  paymentRef         String?     @unique // Stripe Checkout session id
  /// Stable cart snapshot key; cleared only after a confirmed terminal failure.
  checkoutKey        String?     @unique
  checkoutExpiresAt  DateTime?
  /// Immutable Stripe request, reused after network/process failures.
  checkoutParameters Json?
  couponReserved     Boolean     @default(false)
  couponCode         String?
  paidAt             DateTime?
  /// Stripe-hosted receipt for the charge
  receiptUrl         String?
  /// Billing details as they were at checkout
  billing            Json?
  /// Set once the confirmation email has gone out (webhook retries are idempotent)
  confirmationSentAt DateTime?
  confirmationNextAt DateTime?
  confirmationAttempts Int @default(0)
  confirmationLeaseUntil DateTime?
  confirmationLeaseToken String?
  confirmationPayload Json?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  items              OrderItem[]
  checkoutRequests   CheckoutRequest[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([couponCode, couponReserved])
  @@index([status, checkoutExpiresAt])
  @@index([status, confirmationNextAt])
}

/// Client retry keys are scoped to the authenticated buyer, never trusted as ownership.
model CheckoutRequest {
  userId    String
  key       String
  orderId   String
  order     Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@id([userId, key])
  @@index([orderId])
}

model OrderItem {
  id          String @id @default(cuid())
  order       Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  design      Design @relation(fields: [designId], references: [id], onDelete: Restrict)
  designId    String
  tier        Tier   @relation(fields: [tierId], references: [id], onDelete: Restrict)
  tierId      String
  // Snapshot at purchase time so later edits don't change past orders
  designTitle String
  tierName    String
  priceCents  Int
  /// [{ id, name, priceCents }]
  addons      Json   @default("[]")
  personalization OrderPersonalization?
  delivery OrderDelivery?

  @@index([orderId])
}

/// A copy of the saved design at checkout, independent of later draft edits.
model OrderPersonalization {
  orderItemId String @id
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  template String
  content Json
  heroImage Bytes?
  /// Null only for pre-Phase-2 prototype snapshots; never infer a release for them.
  sourceReleaseId String?
  sourceRelease TemplateRelease? @relation(fields: [sourceReleaseId], references: [sha256], onDelete: Restrict)
  formatVersion Int?
  snapshotSha256 String?
  mode String @default("SAVED_DRAFT")
  imageRightsConfirmedAt DateTime?
  images OrderPersonalizationImage[]
}

/// Trusted source bytes retained independently of catalog files and active releases.
model TemplateRelease {
  sha256 String @id
  template String
  templateVersion String
  contentVersion Int
  archive Bytes
  createdAt DateTime @default(now())
  purchases OrderPersonalization[]
  active ActiveTemplateRelease[]
}

model ActiveTemplateRelease {
  template String @id
  releaseId String
  release TemplateRelease @relation(fields: [releaseId], references: [sha256], onDelete: Restrict)
}

/// Checkout creates this job; workers can claim it only after payment is confirmed.
model OrderDelivery {
  orderItemId String @id
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  artifact Bytes?
  artifactStorageKey String?
  artifactSha256 String?
  readyAt DateTime?
  attempts Int @default(0)
  nextAt DateTime? @default(now())
  leaseUntil DateTime?
  leaseToken String?
  lastError String?

  @@index([nextAt])
}

model OrderPersonalizationImage {
  id String @id @default(cuid())
  orderItemId String
  personalization OrderPersonalization @relation(fields: [orderItemId], references: [orderItemId], onDelete: Cascade)
  slot String
  image Bytes

  @@unique([orderItemId, slot])
}

model Coupon {
  id               String    @id @default(cuid())
  code             String    @unique
  percentOff       Int?
  amountOffCents   Int?
  minSubtotalCents Int?
  maxRedemptions   Int?
  redemptions      Int       @default(0)
  expiresAt        DateTime?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
}

model RateLimitBucket {
  key String @id
  count Int
  resetAt DateTime

  @@index([resetAt])
}
